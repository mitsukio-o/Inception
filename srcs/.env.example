# Copy this file to srcs/.env and fill in real values.
# srcs/.env is listed in .gitignore and is never committed.
#
# Passwords must not contain / & \ or ' -- the values are substituted into
# wp-config.php and into SQL, and those four characters break the substitution.

# --- MariaDB -----------------------------------------------------------------
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_user_name
MYSQL_PASSWORD=your_password
MYSQL_ROOT_PASSWORD=your_root_password

# --- How WordPress reaches MariaDB -------------------------------------------
# Do not rename DB_HOST to MYSQL_HOST: that name is read by the MariaDB client
# and would change how root is authenticated inside the mariadb container.
#
# DB_PORT is the single place the database port is written on the client side.
# Changing the port means changing this line and the `port` line in
# srcs/requirements/mariadb/conf/50-server.cnf -- nothing else.
DB_HOST=mariadb
DB_PORT=3306

# --- WordPress ---------------------------------------------------------------
# DOMAIN_NAME is the site address stored in the database by the installer.
# It must match server_name in nginx.conf and the certificate CN.
DOMAIN_NAME=your_login.42.fr
WP_TITLE=your_site_title

# The administrator name must not contain "admin" in any casing.
WP_ADMIN_USER=your_admin_name
WP_ADMIN_PASSWORD=your_admin_password
WP_ADMIN_EMAIL=your_admin@example.com

# A second, non-administrator account.
WP_USER=your_second_user
WP_USER_PASSWORD=your_second_password
WP_USER_EMAIL=your_second@example.com
